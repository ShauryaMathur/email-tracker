{
  "manifest_version": 3,
  "name": "Email Tracker",
  "version": "2.0.0",
  "description": "Tracks when emails you send from Gmail, Outlook, or Yahoo Mail get opened",
  "permissions": ["storage"],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "https://outlook.cloud.microsoft/*",
    "https://mail.yahoo.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://outlook.live.com/*",
        "https://outlook.cloud.microsoft/*",
        "https://mail.yahoo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://email-tracker-1356.onrender.com/setup*"],
      "js": ["auth-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
